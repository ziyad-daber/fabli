generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPPLIER
  RESELLER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPMENT_CREATED
  IN_TRANSIT
  DELIVERED
  REJECTED
  CANCELLED
  DELIVERY_FAILED
  RETURNED
  SHIPMENT_ERROR
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  ERROR
}

enum CommissionStatus {
  PENDING
  DUE
  PAID
  DISPUTED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DISPUTED
}

enum CodStatus {
  EXPECTED
  COLLECTED
  SETTLED
  DISCREPANCY
  REFUNDED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(RESELLER)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  supplierProfile SupplierProfile?
  resellerProfile ResellerProfile?
  sessions       Session[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role, status])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model SupplierProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  contactName String
  phone       String
  address     String
  city        String
  postalCode  String?
  ice         String?
  rc          String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickupAddresses PickupAddress[]
  products      Product[]
  orders        Order[]
  settlements   Settlement[]

  @@index([userId])
  @@index([companyName])
}

model PickupAddress {
  id          String   @id @default(uuid())
  supplierId  String
  name        String
  contactName String
  phone       String
  address     String
  city        String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([supplierId])
}

model ResellerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  contactName String
  phone       String
  address     String
  city        String
  postalCode  String?
  ice         String?
  rc          String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([companyName])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")
  products Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id               String        @id @default(uuid())
  supplierId       String
  categoryId       String
  name             String
  slug             String
  description      String
  shortDescription String?
  supplierPrice    Decimal       @db.Decimal(12, 2)
  currency         String        @default("MAD")
  productionDays   Int           @default(5)
  weight           Decimal?      @db.Decimal(8, 3)
  length           Decimal?      @db.Decimal(8, 2)
  width            Decimal?      @db.Decimal(8, 2)
  height           Decimal?      @db.Decimal(8, 2)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?

  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@unique([supplierId, slug])
  @@index([supplierId, status])
  @@index([categoryId])
  @@index([slug])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  name            String
  value           String
  sku             String?
  additionalPrice Decimal  @default(0) @db.Decimal(12, 2)
  stock           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, name, value])
  @@index([productId])
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  resellerId         String
  supplierId         String
  pickupAddressId    String?
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(12, 2)
  shippingFee        Decimal     @default(0) @db.Decimal(12, 2)
  codAmount          Decimal     @default(0) @db.Decimal(12, 2)
  commissionRate     Decimal     @db.Decimal(5, 4)
  commissionAmount   Decimal     @db.Decimal(12, 2)
  currency           String      @default("MAD")
  customerName       String
  customerPhone      String
  customerEmail      String?
  customerAddress    String
  customerCity       String
  customerPostalCode String?
  customerNotes      String?
  internalNotes      String?
  rejectedReason     String?
  cancelledReason    String?
  acceptedAt         DateTime?
  producedAt         DateTime?
  readyToShipAt      DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  reseller      ResellerProfile    @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  supplier      SupplierProfile    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  pickupAddress PickupAddress?     @relation(fields: [pickupAddressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  shipments     Shipment[]
  commission    Commission?
  codCollection CodCollection?

  @@index([resellerId, status])
  @@index([supplierId, status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  productId          String
  variantId          String?
  quantity           Int      @default(1)
  unitSupplierPrice  Decimal  @db.Decimal(12, 2)
  unitResellerPrice  Decimal  @db.Decimal(12, 2)
  unitCommission     Decimal  @db.Decimal(12, 2)
  totalSupplierPrice Decimal  @db.Decimal(12, 2)
  totalResellerPrice Decimal  @db.Decimal(12, 2)
  totalCommission    Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String
  actorRole  UserRole
  notes      String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String
  externalId     String?
  trackingCode   String?        @unique
  labelUrl       String?
  status         ShipmentStatus @default(CREATED)
  carrier        String         @default("AMEEX")
  pieces         Int            @default(1)
  weight         Decimal?       @db.Decimal(8, 3)
  length         Decimal?       @db.Decimal(8, 2)
  width          Decimal?       @db.Decimal(8, 2)
  height         Decimal?       @db.Decimal(8, 2)
  codAmount      Decimal?       @db.Decimal(12, 2)
  pickupAddress  Json?
  deliveryAddress Json?
  idempotencyKey String         @unique
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  lastTrackingAt DateTime?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  apiLogs       CourierApiLog[]
  codCollection CodCollection?

  @@index([orderId])
  @@index([trackingCode])
  @@index([externalId])
  @@index([status])
}

model CourierIntegration {
  id         String   @id @default(uuid())
  name       String   @default("AMEEX")
  isActive   Boolean  @default(true)
  apiKey     String?
  apiSecret  String?
  accountId  String?
  baseUrl    String   @default("https://api.ameex.app")
  testMode   Boolean  @default(true)
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  apiLogs CourierApiLog[]

  @@index([isActive])
}

model CourierApiLog {
  id            String             @id @default(uuid())
  integrationId String
  shipmentId    String?
  method        String
  endpoint      String
  requestBody   Json?
  responseBody  Json?
  statusCode    Int?
  errorMessage  String?
  durationMs    Int?
  createdAt     DateTime           @default(now())

  integration CourierIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  shipment    Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([integrationId, createdAt])
  @@index([shipmentId])
}

model Commission {
  id           String           @id @default(uuid())
  orderId      String           @unique
  rate         Decimal          @db.Decimal(5, 4)
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("MAD")
  status       CommissionStatus @default(PENDING)
  calculatedAt DateTime         @default(now())
  dueAt        DateTime?
  paidAt       DateTime?
  settledAt    DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  settlementItems  SettlementTransaction[]

  @@index([status, dueAt])
}

model Settlement {
  id              String           @id @default(uuid())
  supplierId      String
  periodStart     DateTime
  periodEnd       DateTime
  totalCommission Decimal          @db.Decimal(12, 2)
  totalCod       Decimal          @db.Decimal(12, 2)
  netAmount       Decimal          @db.Decimal(12, 2)
  currency        String           @default("MAD")
  status          SettlementStatus @default(PENDING)
  reference       String?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  supplier     SupplierProfile        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  transactions SettlementTransaction[]

  @@index([supplierId, status])
  @@index([periodStart, periodEnd])
}

model SettlementTransaction {
  id           String   @id @default(uuid())
  settlementId String?
  commissionId String?
  type         String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("MAD")
  description  String?
  reference    String?
  createdAt    DateTime @default(now())

  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([commissionId])
}

model CodCollection {
  id               String    @id @default(uuid())
  orderId          String    @unique
  shipmentId       String?   @unique
  expectedAmount   Decimal   @db.Decimal(12, 2)
  collectedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  settledAmount    Decimal   @default(0) @db.Decimal(12, 2)
  currency         String    @default("MAD")
  status           CodStatus @default(EXPECTED)
  collectedAt      DateTime?
  settledAt        DateTime?
  carrierReference String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([shipmentId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model NotificationLog {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  recipient String
  subject   String?
  body      String
  status    String
  error     String?
  metadata  Json?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

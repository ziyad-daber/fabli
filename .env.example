# ---------------------------------------------------------------------------
# Fabli — variables d'environnement
# Copiez ce fichier vers .env et renseignez les valeurs.
# NE versionnez jamais .env (il est ignoré par .gitignore).
# ---------------------------------------------------------------------------

# --- Base de données --------------------------------------------------------
# PostgreSQL 16. En Docker Compose, utiliser le service `postgres` :
# DATABASE_URL="postgresql://fabli:MOT_DE_PASSE@postgres:5432/fabli?schema=public"
DATABASE_URL="postgresql://fabli:CHANGE_ME@localhost:5432/fabli?schema=public"

# Variables lues par le service postgres de docker-compose.yml
POSTGRES_DB="fabli"
POSTGRES_USER="fabli"
POSTGRES_PASSWORD="CHANGE_ME"

# --- Authentification (NextAuth) --------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# --- Application ------------------------------------------------------------
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED=1

# --- Domaine / HTTPS (nginx + certbot) --------------------------------------
# Domaine de production, sans protocole. Sert à rendre le certificat
# Let's Encrypt et le server block nginx.
DOMAIN="example.com"

# --- AMEEX ------------------------------------------------------------------
# Clf de chiffrement des identifiants AMEEX stockés en base (AES-256-GCM).
# OBLIGATOIRE en production. Générer avec : openssl rand -hex 32
# Les identifiants AMEEX eux-mêmes (apiKey, accountId) sont saisis par
# l'administrateur depuis /dashboard/admin/ameex et ne vivent jamais ici.
AMEEX_ENCRYPTION_KEY=""

# URL de base de l'API AMEEX. Valeur par défaut si la ligne est absente.
AMEEX_BASE_URL="https://api.ameex.app"

# --- Stockage des fichiers --------------------------------------------------
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# --- Sauvegardes (service `backup`) ------------------------------------------
BACKUP_RETENTION_DAYS="14"
BACKUP_INTERVAL_SECONDS="86400"

# --- Notifications (§7) -----------------------------------------------------
# Les notifications sont systématiquement journalisées dans NotificationLog.
# Sans canal configuré, le message est journalisé et reste consultable dans
# les tableaux de bord : le Code Suivi peut aussi être copié manuellement.
NOTIFICATION_TRANSPORT="log"

# E-mail (SMTP) — optionnel
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@example.com"

# SMS (Twilio) — optionnel
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Database - PostgreSQL with Prisma
# Option 1: Local PostgreSQL (for Docker dev)
DATABASE_URL="postgresql://fabli:CHANGE_ME@localhost:5432/fabli?schema=public"
# Option 2: Remote PostgreSQL (e.g., hosted, cloud, or tunnel)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"
NEXTAUTH_URL="https://your-domain.com"

# App
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED=1

# Domain (for nginx/SSL)
DOMAIN="your-domain.com"

# AMEEX Integration (configured by admin in dashboard, but base URL here)
AMEEX_BASE_URL="https://api.ameex.app"
AMEEX_TEST_MODE="true"

# Email (optional - for notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@your-domain.com"

# SMS/WhatsApp (optional - for notifications)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# Rate Limiting
RATE_LIMIT_API="10"
RATE_LIMIT_AUTH="5"